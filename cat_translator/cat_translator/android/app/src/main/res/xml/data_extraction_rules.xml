<?xml version="1.0" encoding="utf-8"?>
<!-- 개인정보처리방침("피드백 데이터는 기기에만 저장, 앱 삭제 시 함께 삭제")과 맞추기 위해
     Android 12+ 클라우드 백업/기기 간 이전 대상에서 앱 데이터를 모두 제외한다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
